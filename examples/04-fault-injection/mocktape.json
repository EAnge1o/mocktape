{
  "port": 3000,
  "latency": [50, 150],
  "routes": [
    {
      "name": "checkout",
      "method": "POST",
      "path": "/checkout",
      "body": { "orderId": "{{ $uuid }}", "state": "confirmed" }
    },
    {
      "name": "flaky inventory",
      "method": "GET",
      "path": "/inventory/:sku",
      "body": { "sku": "{{ request.path.sku }}", "stock": 7 },
      "fault": { "type": "error", "rate": 0.3 }
    },
    {
      "name": "hung payments",
      "method": "POST",
      "path": "/payments",
      "body": { "ok": true },
      "fault": { "type": "latency", "rate": 0.5, "latencyMs": [3000, 5000] }
    },
    {
      "name": "corrupting CDN",
      "method": "GET",
      "path": "/assets/:file",
      "body": "should never be seen",
      "fault": { "type": "garbage", "rate": 0.5 }
    },
    {
      "name": "dropping webhooks",
      "method": "POST",
      "path": "/webhooks",
      "body": { "ok": true },
      "fault": { "type": "reset", "rate": 0.5 }
    }
  ]
}
